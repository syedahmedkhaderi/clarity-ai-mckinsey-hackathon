# LOOP configuration. Copy to .env. Every value here is optional.
#
# Provider is chosen automatically:
#   QB_CLIENT_ID + QB_CLIENT_SECRET  -> QuantumBlack Azure AI gateway
#   OPENAI_API_KEY                   -> OpenAI directly
#   neither                          -> offline deterministic rules
#
# A qb_gateway/.env sitting next to this project is read automatically, so
# gateway credentials do not need copying in here.

OPENAI_API_KEY=

# QuantumBlack Azure AI gateway. Leave blank to use qb_gateway/.env.
QB_CLIENT_ID=
QB_CLIENT_SECRET=
LOOP_AZURE_INSTANCE_ID=
LOOP_AZURE_ENDPOINT=
LOOP_AZURE_API_VERSION=

# Leave blank to take the right default for the detected provider.
LOOP_MODEL_FAST=
LOOP_MODEL_SMART=

LOOP_LLM_CONCURRENCY=12
LOOP_LLM_TIMEOUT=90
LOOP_DB_PATH=
LOOP_FACILITATOR_MINUTES=120

# Email. Leave blank and student emails are saved but never delivered. Use a
# Gmail app password (Google Account, Security, 2-Step Verification, App
# passwords), not your normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_TIMEOUT_SECONDS=
